# Copia a ".env" en la raiz del proyecto para usar con docker-compose.
# NUNCA subas ".env" al repositorio.

AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# RabbitMQ (repo mesatech-rabbit). En local corre en tu PC; en EC2 va la IP privada de la EC2 de RabbitMQ.
RABBIT_HOST=host.docker.internal
# Claves de los usuarios de las apps: las mismas que se pusieron en el .env de mesatech-rabbit
CATALOGO_RABBIT_PASSWORD=cambiar_clave_publicador
SOLICITUDES_RABBIT_PASSWORD=cambiar_clave_consumidor
